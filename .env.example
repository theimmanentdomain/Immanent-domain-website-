# Server-only. Select a dedicated public IMDO calendar, never "primary".
GOOGLE_PUBLIC_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
# Set true only after confirming the selected calendar is intended for publication.
IMDO_CALENDAR_PUBLISH_APPROVED=false

# Optional Google Search Console HTML-tag verification token (not the full tag).
GOOGLE_SITE_VERIFICATION=

# OSINT server-only publishing credentials. Never prefix with NEXT_PUBLIC_.
# Fine-grained GitHub token: only this repository, Contents read/write.
OSINT_GITHUB_TOKEN=
# Explicit verified production branch, e.g. main. Do not guess on deployment.
OSINT_GITHUB_BRANCH=
# Separate secret held by the report producer and the publication endpoint.
OSINT_PUBLISH_TOKEN=
